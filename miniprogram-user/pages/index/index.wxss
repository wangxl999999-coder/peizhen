.index-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
}

.city-select {
  display: flex;
  align-items: center;
}

.city-name {
  font-size: 32rpx;
  font-weight: bold;
}

.arrow {
  font-size: 20rpx;
  margin-left: 8rpx;
  color: #666;
}

.header-right {
  display: flex;
  align-items: center;
}

.service-btn {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #fff;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.swiper-banner {
  height: 280rpx;
  margin-bottom: 20rpx;
}

.banner-item {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
}

.service-grid {
  display: flex;
  flex-wrap: wrap;
}

.service-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.service-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 12rpx;
}

.service-icon-placeholder {
  width: 96rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  padding: 4rpx;
}

.service-icon-placeholder.small {
  width: 72rpx;
  height: 72rpx;
  font-size: 22rpx;
}

.service-name {
  font-size: 24rpx;
  color: #333;
  margin-top: 8rpx;
}

.companion-list {
  display: flex;
  flex-direction: column;
}

.companion-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.companion-item:last-child {
  border-bottom: none;
}

.companion-avatar-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  margin-right: 20rpx;
}

.companion-avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.rating-badge {
  position: absolute;
  bottom: -8rpx;
  right: -8rpx;
  background: #faad14;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 20rpx;
}

.companion-info {
  flex: 1;
}

.companion-name {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.companion-meta {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.companion-stats {
  font-size: 22rpx;
  color: #999;
}

.faq-list {
  display: flex;
  flex-direction: column;
}

.faq-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-q {
  font-size: 26rpx;
  color: #333;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 0;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-icon {
  margin-bottom: 12rpx;
}

.more {
  font-size: 24rpx;
  color: #999;
}
