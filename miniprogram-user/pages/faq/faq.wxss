.faq-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.faq-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.faq-item {
  border-bottom: 1rpx solid #f5f5f5;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
}

.question-text {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.arrow {
  font-size: 32rpx;
  color: #999;
  transition: transform 0.3s;
}

.arrow.expanded {
  transform: rotate(90deg);
}

.faq-answer {
  padding: 0 30rpx 30rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 1.8;
}

.contact-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  text-align: center;
  margin-top: 30rpx;
}

.contact-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.contact-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.contact-btn {
  display: inline-block;
  padding: 20rpx 60rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
}
