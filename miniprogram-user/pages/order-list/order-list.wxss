.order-list-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab.active {
  color: #07C160;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #07C160;
  border-radius: 2rpx;
}

.order-list {
  padding: 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.order-no {
  font-size: 24rpx;
  color: #999;
}

.order-content {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.order-companion {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 30rpx;
}

.companion-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 20rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.companion-name {
  font-size: 22rpx;
  color: #666;
}

.order-info {
  flex: 1;
}

.order-service {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.order-hospital {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.order-time {
  font-size: 24rpx;
  color: #999;
}

.order-footer {
  text-align: right;
}

.order-price {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.empty {
  padding: 100rpx 60rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty text {
  display: block;
  color: #999;
  font-size: 28rpx;
  margin-bottom: 40rpx;
}
