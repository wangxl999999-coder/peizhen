.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #07C160 0%, #06AD56 100%);
  display: flex;
  flex-direction: column;
}

.login-header {
  padding: 100rpx 0 60rpx;
  text-align: center;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 30rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 48rpx;
  font-weight: bold;
}

.slogan {
  color: #fff;
  font-size: 36rpx;
}

.login-content {
  flex: 1;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 60rpx 40rpx;
  margin-top: 40rpx;
}

.features {
  display: flex;
  justify-content: space-around;
  margin-bottom: 80rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feature-icon {
  width: 60rpx;
  height: 60rpx;
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  font-size: 28rpx;
}

.login-btn {
  height: 88rpx;
  margin-bottom: 30rpx;
}

.agreement {
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.link {
  color: #07C160;
}
