.complaint-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.textarea-input {
  width: 100%;
  height: 160rpx;
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea-input.large {
  height: 300rpx;
}

.tip {
  padding: 30rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.submit-section {
  padding: 40rpx 30rpx;
}
