.companion-detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

.header {
  position: relative;
  padding: 40rpx 30rpx 80rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
}

.companion-info-card {
  position: relative;
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.companion-avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}

.companion-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

.online-status {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #999;
  border: 4rpx solid #fff;
}

.online-status.online {
  background: #07C160;
}

.companion-info {
  flex: 1;
}

.companion-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.companion-meta {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.companion-meta text {
  margin-right: 20rpx;
}

.companion-rating {
  display: flex;
  align-items: center;
}

.rating-score {
  font-size: 40rpx;
  color: #faad14;
  font-weight: bold;
}

.rating-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}

.order-count, .good-rate {
  font-size: 24rpx;
  color: #666;
  margin-right: 20rpx;
}

.qualification-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
}

.qualification-label {
  color: #999;
}

.qualification-value {
  color: #333;
}

.skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.skill-tag {
  padding: 10rpx 24rpx;
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

.case-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.case-item:last-child {
  border-bottom: none;
}

.case-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.case-title {
  font-size: 28rpx;
  font-weight: bold;
}

.case-date {
  font-size: 24rpx;
  color: #999;
}

.case-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.case-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.case-images image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
}

.evaluation-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.evaluation-item:last-child {
  border-bottom: none;
}

.evaluation-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 18rpx;
  margin-right: 16rpx;
}

.user-avatar.anonymous {
  background: #ddd;
  font-size: 16rpx;
}

.user-name {
  font-size: 26rpx;
}

.rating {
  display: flex;
}

.star {
  color: #ddd;
  font-size: 28rpx;
}

.star.filled {
  color: #faad14;
}

.evaluation-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  margin-bottom: 10rpx;
}

.evaluation-date {
  font-size: 24rpx;
  color: #999;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.05);
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  margin: 0 10rpx;
}

.footer-btn.call {
  background: #f5f5f5;
  color: #666;
}

.footer-btn.book {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #fff;
}
