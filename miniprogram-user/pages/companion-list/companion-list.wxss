.companion-list-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.sort-tabs {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.sort-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.sort-tab.active {
  color: #07C160;
  font-weight: bold;
}

.sort-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #07C160;
  border-radius: 2rpx;
}

.companion-list {
  padding: 20rpx;
}

.companion-card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.companion-avatar-wrap {
  position: relative;
  margin-right: 24rpx;
}

.companion-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.rating-badge {
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  background: #faad14;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

.companion-info {
  flex: 1;
}

.companion-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.companion-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.companion-gender {
  font-size: 24rpx;
  color: #999;
}

.companion-qualification {
  font-size: 24rpx;
  color: #07C160;
  background: rgba(7, 193, 96, 0.1);
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-bottom: 8rpx;
}

.companion-stats {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.companion-stats text {
  margin-right: 20rpx;
}

.companion-intro {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.empty {
  padding: 100rpx 0;
  text-align: center;
  color: #999;
}
