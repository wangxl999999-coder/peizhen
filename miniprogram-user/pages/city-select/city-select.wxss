.city-select-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.current-city {
  background: #fff;
  padding: 30rpx;
  display: flex;
  align-items: center;
}

.current-city .label {
  color: #999;
  margin-right: 20rpx;
}

.current-city .city {
  font-size: 32rpx;
  font-weight: bold;
  color: #07C160;
}

.hot-section, .all-section {
  background: #fff;
  margin-top: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.city-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.city-item {
  width: calc(33.33% - 14rpx);
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.letter-group {
  margin-bottom: 20rpx;
}

.letter {
  font-size: 28rpx;
  font-weight: bold;
  color: #07C160;
  margin-bottom: 10rpx;
}

.city-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.city-list .city-item {
  width: calc(25% - 12rpx);
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}
