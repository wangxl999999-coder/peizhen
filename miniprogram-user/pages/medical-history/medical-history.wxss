.medical-history-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.record-service {
  font-size: 32rpx;
  font-weight: bold;
}

.record-status {
  font-size: 24rpx;
  color: #999;
}

.record-status.pending {
  color: #07C160;
}

.record-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.record-row {
  display: flex;
  font-size: 26rpx;
}

.record-row .label {
  width: 120rpx;
  color: #999;
}

.record-row .value {
  flex: 1;
  color: #333;
}

.record-footer {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.post-service {
  background: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.post-item {
  display: flex;
  font-size: 24rpx;
  margin-bottom: 10rpx;
}

.post-item:last-child {
  margin-bottom: 0;
}

.post-label {
  color: #999;
  margin-right: 10rpx;
}

.post-value {
  flex: 1;
  color: #333;
}

.empty {
  padding: 100rpx 60rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty text {
  display: block;
  color: #999;
  font-size: 28rpx;
}
