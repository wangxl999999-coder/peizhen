.income-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.income-header {
  position: relative;
  padding: 40rpx 30rpx 80rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
}

.income-card {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.income-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.income-amount {
  font-size: 64rpx;
  font-weight: bold;
  color: #07C160;
  margin-bottom: 30rpx;
}

.income-detail {
  display: flex;
  padding-top: 30rpx;
  border-top: 1rpx solid #f5f5f5;
}

.detail-item {
  flex: 1;
}

.detail-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.detail-label {
  font-size: 24rpx;
  color: #999;
}

.total-card {
  display: flex;
  background: #fff;
  margin: -40rpx 30rpx 0;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.total-item {
  flex: 1;
  text-align: center;
}

.total-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #07C160;
  margin-bottom: 10rpx;
}

.total-label {
  font-size: 24rpx;
  color: #999;
}

.section {
  margin: 30rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.month-list {
  display: flex;
  flex-direction: column;
}

.month-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.month-item:last-child {
  border-bottom: none;
}

.month-info {
  display: flex;
  align-items: center;
}

.month-name {
  font-size: 28rpx;
  color: #333;
  margin-right: 20rpx;
}

.month-orders {
  font-size: 24rpx;
  color: #999;
}

.month-amount {
  font-size: 30rpx;
  font-weight: bold;
  color: #07C160;
}

.empty {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.withdraw-section {
  margin: 40rpx 30rpx;
}
