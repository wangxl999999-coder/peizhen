.container {
  padding-bottom: 140rpx;
}

.status-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.status-item {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
}

.status-item.active {
  background: #07C160;
  color: #fff;
}

.complaint-list {
  padding: 20rpx;
}

.complaint-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.type {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-pending {
  background: #fff7e6;
  color: #faad14;
}

.status-processing {
  background: #e6f7ff;
  color: #1890ff;
}

.status-completed {
  background: #f6ffed;
  color: #07C160;
}

.card-body {
  margin-bottom: 20rpx;
}

.content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.handle-result {
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.handle-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.handle-text {
  font-size: 26rpx;
  color: #07C160;
}

.create-time {
  font-size: 24rpx;
  color: #999;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.loading, .no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}
