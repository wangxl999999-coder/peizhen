.skills-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.skill-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.skill-item {
  padding: 16rpx 32rpx;
  border: 2rpx solid #ddd;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
}

.skill-item.selected {
  border-color: #07C160;
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
}

.selected-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.selected-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.selected-tag {
  padding: 12rpx 24rpx;
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.empty {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.05);
}
