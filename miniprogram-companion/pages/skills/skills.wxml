<view class="skills-page">
  <view class="card">
    <view class="section-title">选择擅长服务类型</view>
    <view class="skill-grid">
      <view class="skill-item {{selectedSkills.indexOf(item) > -1 ? 'selected' : ''}}"
            wx:for="{{allSkills}}" wx:key="*this"
            bindtap="toggleSkill" data-skill="{{item}}">
        {{item}}
      </view>
    </view>
  </view>

  <view class="selected-card">
    <view class="section-title">已选择 ({{selectedSkills.length}})</view>
    <view class="selected-tags" wx:if="{{selectedSkills.length > 0}}">
      <view class="selected-tag" wx:for="{{selectedSkills}}" wx:key="*this">
        {{item}}
      </view>
    </view>
    <view class="empty" wx:else>
      <text>暂未选择任何技能</text>
    </view>
  </view>

  <view class="submit-section">
    <button class="btn btn-primary btn-block" bindtap="save">保存</button>
  </view>
</view>
