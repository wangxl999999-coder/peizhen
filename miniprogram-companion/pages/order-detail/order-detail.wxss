.order-detail-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

.status-card {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.status-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.status-tip {
  font-size: 26rpx;
  opacity: 0.9;
}

.card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row {
  display: flex;
  padding: 16rpx 0;
  font-size: 28rpx;
}

.info-label {
  width: 160rpx;
  color: #999;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: #333;
  word-break: break-all;
}

.phone-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.call-btn {
  font-size: 36rpx;
}

.total-row {
  padding-top: 20rpx;
  margin-top: 10rpx;
  border-top: 1rpx solid #f5f5f5;
}

.total-row .info-value {
  color: #07C160;
  font-size: 32rpx;
  font-weight: bold;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 20rpx rgba(0, 0, 0, 0.05);
}

.action-bar .btn {
  flex: 1;
}
