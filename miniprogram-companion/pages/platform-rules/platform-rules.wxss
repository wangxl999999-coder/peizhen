.container {
  padding-bottom: 40rpx;
}

.type-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.type-item {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
}

.type-item.active {
  background: #07C160;
  color: #fff;
}

.rule-list {
  padding: 20rpx;
}

.rule-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.rule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.rule-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.rule-version {
  font-size: 24rpx;
  color: #07C160;
  background: rgba(7, 193, 96, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.rule-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.rule-time {
  font-size: 24rpx;
  color: #999;
}
