.login-page {
  min-height: 100vh;
  background: #fff;
  padding: 80rpx 60rpx;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
}

.login-form {
  margin-bottom: 60rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.code-input-wrap {
  display: flex;
  gap: 20rpx;
}

.code-input-wrap .form-input {
  flex: 1;
}

.code-btn {
  width: 220rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.login-btn {
  height: 88rpx;
  margin-top: 20rpx;
  font-size: 32rpx;
}

.divider {
  text-align: center;
  margin: 40rpx 0;
  color: #999;
  font-size: 26rpx;
  position: relative;
}

.divider::before,
.divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 30%;
  height: 1rpx;
  background: #ddd;
}

.divider::before {
  left: 0;
}

.divider::after {
  right: 0;
}

.wx-login-btn {
  height: 88rpx;
  background: #07C160;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.wx-icon {
  font-size: 32rpx;
}

.login-footer {
  text-align: center;
  font-size: 24rpx;
  color: #999;
}

.link {
  color: #07C160;
}
