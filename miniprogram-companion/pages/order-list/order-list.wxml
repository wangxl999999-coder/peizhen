<view class="order-list-page">
  <view class="tabs">
    <scroll-view scroll-x="true" class="tabs-scroll">
      <view class="tab-item {{currentTab === index ? 'active' : ''}}" 
            wx:for="{{tabs}}" wx:key="status"
            bindtap="switchTab" data-index="{{index}}">
        {{item.label}}
      </view>
    </scroll-view>
  </view>

  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="order-header">
        <view class="order-info">
          <text class="order-no">订单号: {{item.order_no}}</text>
          <text class="order-status status-{{item.status}}">{{item.status_text}}</text>
        </view>
      </view>
      
      <view class="order-body">
        <view class="order-row">
          <text class="row-label">服务类型</text>
          <text class="row-value">{{item.service_name}}</text>
        </view>
        <view class="order-row">
          <text class="row-label">服务时间</text>
          <text class="row-value">{{item.service_date}} {{item.start_time}}</text>
        </view>
        <view class="order-row">
          <text class="row-label">服务地点</text>
          <text class="row-value">{{item.hospital_name}}</text>
        </view>
      </view>

      <view class="order-footer">
        <text class="order-price">¥{{item.total_price}}</text>
        <view class="order-actions" catchtap="">
          <button class="btn btn-primary" wx:if="{{item.status === 'pending_accept'}}" 
                  bindtap="acceptOrder" data-id="{{item.id}}">接单</button>
          <button class="btn btn-primary" wx:if="{{item.status === 'pending_service'}}" 
                  bindtap="startService" data-id="{{item.id}}">开始服务</button>
          <button class="btn btn-primary" wx:if="{{item.status === 'in_service'}}" 
                  bindtap="completeService" data-id="{{item.id}}">完成服务</button>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-icon">📋</view>
    <text>暂无订单</text>
  </view>
</view>
