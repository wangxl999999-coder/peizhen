<view class="container">
  <view class="tabs">
    <view 
      wx:for="{{tabs}}" 
      wx:key="key" 
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >
      {{item.label}}
    </view>
  </view>

  <block wx:if="{{activeTab === 'withdraw'}}">
    <view class="balance-section">
      <text class="balance-label">可提现金额（元）</text>
      <text class="balance-amount">{{statistics?.withdrawable || '0.00'}}</text>
      <text class="balance-tip">提现金额将转入您的微信钱包</text>
    </view>

    <view class="form-section">
      <view class="form-item">
        <text class="label">提现金额</text>
        <view class="input-wrapper">
          <text class="currency">¥</text>
          <input 
            class="amount-input" 
            type="digit" 
            placeholder="请输入提现金额"
            value="{{amount}}"
            bindinput="onAmountInput"
          />
          <text class="max-btn" bindtap="setMaxAmount">全部提现</text>
        </view>
      </view>

      <view class="form-item">
        <text class="label">备注（选填）</text>
        <input 
          class="input" 
          placeholder="请输入备注信息"
          value="{{remark}}"
          bindinput="onRemarkInput"
        />
      </view>

      <view class="tip-section">
        <text class="tip-title">提现说明：</text>
        <text class="tip-item">1. 最低提现金额为10元</text>
        <text class="tip-item">2. 提现申请将在1-3个工作日内处理</text>
        <text class="tip-item">3. 提现金额将转入您的微信钱包</text>
      </view>
    </view>

    <view class="submit-section">
      <button 
        class="btn btn-primary btn-block {{isSubmitting ? 'disabled' : ''}}" 
        bindtap="submitWithdraw"
        disabled="{{isSubmitting}}"
      >
        {{isSubmitting ? '提交中...' : '确认提现'}}
      </button>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{withdrawList.length === 0 && !loading}}" class="empty">
      <view class="empty-icon">📝</view>
      <text>暂无提现记录</text>
    </view>

    <view wx:else class="withdraw-list">
      <view wx:for="{{withdrawList}}" wx:key="id" class="withdraw-item">
        <view class="item-left">
          <text class="item-amount">-{{item.amount}}</text>
          <text class="item-time">{{item.create_time}}</text>
        </view>
        <view class="item-right">
          <text class="item-status status-{{item.status}}">{{item.status === 'pending' ? '待处理' : item.status === 'success' ? '已到账' : '失败'}}</text>
          <text wx:if="{{item.remark}}" class="item-remark">{{item.remark}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading">加载中...</view>
    <view wx:if="{{noMore && withdrawList.length > 0}}" class="no-more">没有更多记录了</view>
  </block>
</view>
