.container {
  padding-bottom: 140rpx;
}

.tabs {
  display: flex;
  background: #fff;
  padding: 0 30rpx;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #07C160;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #07C160;
  border-radius: 2rpx;
}

.balance-section {
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  padding: 60rpx 30rpx;
  text-align: center;
  color: #fff;
}

.balance-label {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.balance-amount {
  display: block;
  font-size: 80rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.balance-tip {
  font-size: 24rpx;
  opacity: 0.8;
}

.form-section {
  background: #fff;
  margin: 30rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 20rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.currency {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  height: 88rpx;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.max-btn {
  font-size: 26rpx;
  color: #07C160;
  padding: 8rpx 20rpx;
  background: rgba(7, 193, 96, 0.1);
  border-radius: 20rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

.tip-section {
  margin-top: 30rpx;
  padding: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.tip-item {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.disabled {
  opacity: 0.6;
}

.withdraw-list {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
}

.withdraw-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.withdraw-item:last-child {
  border-bottom: none;
}

.item-amount {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #ff4d4f;
  margin-bottom: 8rpx;
}

.item-time {
  font-size: 24rpx;
  color: #999;
}

.item-status {
  display: block;
  font-size: 26rpx;
  text-align: right;
  margin-bottom: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.status-pending {
  background: #fff7e6;
  color: #faad14;
}

.status-success {
  background: #f6ffed;
  color: #07C160;
}

.status-failed {
  background: #fff1f0;
  color: #ff4d4f;
}

.item-remark {
  font-size: 24rpx;
  color: #999;
}

.loading, .no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}
