<view class="container">
  <view class="tabs">
    <view 
      wx:for="{{tabs}}" 
      wx:key="key" 
      class="tab-item {{activeTab === item.key ? 'active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{orders.length === 0 && !loading}}" class="empty">
    <view class="empty-icon">📋</view>
    <text>暂无订单</text>
    <text>{{activeTab === 'nearby' ? '附近暂无订单' : activeTab === 'recommend' ? '暂无推荐订单' : '请稍后再试'}}</text>
  </view>

  <view wx:else class="order-list">
    <view 
      wx:for="{{orders}}" 
      wx:key="id" 
      class="order-card"
      data-id="{{item.id}}"
      bindtap="goToOrderDetail"
    >
      <view class="card-header">
        <view class="order-info">
          <text class="order-type">{{item.service_name}}</text>
          <text wx:if="{{item.distance}}" class="distance">{{item.distance}}</text>
        </view>
        <text class="status-badge status-{{item.status}}">{{item.status_text}}</text>
      </view>

      <view class="card-body">
        <view class="info-row">
          <text class="icon">🏥</text>
          <text class="text">{{item.hospital_name}}</text>
        </view>
        <view class="info-row">
          <text class="icon">📅</text>
          <text class="text">{{item.service_date}} {{item.time_slot}}</text>
        </view>
        <view wx:if="{{item.department_name}}" class="info-row">
          <text class="icon">🏷️</text>
          <text class="text">{{item.department_name}}</text>
        </view>
        <view wx:if="{{item.service_desc}}" class="info-row desc">
          <text class="text">{{item.service_desc}}</text>
        </view>
      </view>

      <view class="card-footer">
        <text class="price">¥{{item.total_price}}</text>
        <button 
          class="btn btn-primary grab-btn" 
          data-id="{{item.id}}" 
          catchtap="grabOrder"
        >
          立即抢单
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:if="{{noMore && orders.length > 0}}" class="no-more">没有更多订单了</view>
</view>
