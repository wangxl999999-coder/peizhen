.companion-index {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 100rpx;
}

.header {
  position: relative;
  padding: 40rpx 30rpx 80rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
}

.user-card {
  position: relative;
  display: flex;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.user-meta {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.user-rating {
  display: flex;
  align-items: center;
}

.rating-score {
  font-size: 36rpx;
  color: #faad14;
  font-weight: bold;
}

.rating-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}

.order-count {
  font-size: 24rpx;
  color: #666;
}

.status-tag {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-tag.online {
  background: #f6ffed;
  color: #07C160;
}

.status-tag.offline {
  background: #f5f5f5;
  color: #999;
}

.statistics-card {
  display: flex;
  background: #fff;
  margin: -40rpx 30rpx 0;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #07C160;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.section {
  margin-top: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

.order-list {
  padding: 0 20rpx;
}

.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.order-status {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.order-price {
  font-size: 32rpx;
  font-weight: bold;
  color: #07C160;
}

.order-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.order-row {
  display: flex;
  font-size: 26rpx;
}

.row-label {
  width: 80rpx;
  color: #999;
}

.row-value {
  flex: 1;
  color: #333;
}

.order-footer {
  display: flex;
  justify-content: flex-end;
}

.empty {
  padding: 60rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}
