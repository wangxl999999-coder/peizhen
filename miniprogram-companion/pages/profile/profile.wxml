<view class="profile-page" wx:if="{{userInfo}}">
  <view class="profile-header">
    <view class="header-bg"></view>
    <view class="user-card">
      <view class="user-avatar">{{userInfo.real_name}}</view>
      <view class="user-info">
        <view class="user-name">{{userInfo.real_name}}</view>
        <view class="user-rating">
          <text class="rating-score">{{userInfo.rating}}</text>
          <text class="rating-label">分</text>
          <text class="order-count">{{userInfo.order_count}}单</text>
        </view>
      </view>
      <view class="edit-btn" bindtap="goEdit">编辑</view>
    </view>
  </view>

  <view class="statistics-card">
    <view class="stat-item">
      <text class="stat-value">{{userInfo.order_count}}</text>
      <text class="stat-label">累计订单</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{userInfo.good_rate}}%</text>
      <text class="stat-label">好评率</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{userInfo.experience}}</text>
      <text class="stat-label">从业年限</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goVerification">
      <view class="menu-icon">🪪</view>
      <text class="menu-text">实名认证</text>
      <text wx:if="{{userInfo.verification_status}}" class="menu-value status-{{userInfo.verification_status}}">{{userInfo.verification_status === 'approved' ? '已通过' : userInfo.verification_status === 'pending' ? '审核中' : '待提交'}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goQualifications">
      <view class="menu-icon">📄</view>
      <text class="menu-text">资质管理</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goServiceSettings">
      <view class="menu-icon">⚙️</view>
      <text class="menu-text">服务设置</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goEvaluations">
      <view class="menu-icon">⭐</view>
      <text class="menu-text">我的评价</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goSkills">
      <view class="menu-icon">💪</view>
      <text class="menu-text">擅长技能</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goIncome">
      <view class="menu-icon">💰</view>
      <text class="menu-text">收入统计</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goServiceRecord">
      <view class="menu-icon">📝</view>
      <text class="menu-text">服务记录</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="goTrainings">
      <view class="menu-icon">📚</view>
      <text class="menu-text">培训资料</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goPlatformRules">
      <view class="menu-icon">📋</view>
      <text class="menu-text">平台规则</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goComplaints">
      <view class="menu-icon">💬</view>
      <text class="menu-text">投诉建议</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item">
      <view class="menu-icon">📞</view>
      <text class="menu-text">客服热线</text>
      <text class="menu-value">400-888-8888</text>
    </view>
    <view class="menu-item">
      <view class="menu-icon">ℹ️</view>
      <text class="menu-text">关于我们</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-section">
    <button class="btn btn-danger btn-block" bindtap="logout">退出登录</button>
  </view>
</view>
