.profile-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

.profile-header {
  position: relative;
  padding: 60rpx 30rpx 80rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
}

.user-card {
  position: relative;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.user-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-right: 24rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.user-rating {
  display: flex;
  align-items: center;
}

.rating-score {
  font-size: 32rpx;
  color: #faad14;
  font-weight: bold;
}

.rating-label {
  font-size: 24rpx;
  color: #999;
  margin-right: 20rpx;
}

.order-count {
  font-size: 24rpx;
  color: #666;
}

.edit-btn {
  padding: 12rpx 24rpx;
  background: rgba(7, 193, 96, 0.1);
  color: #07C160;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.statistics-card {
  display: flex;
  background: #fff;
  margin: -40rpx 30rpx 0;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #07C160;
  margin-bottom: 10rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.menu-list {
  background: #fff;
  margin: 30rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
}

.menu-value {
  font-size: 26rpx;
  color: #999;
  margin-right: 10rpx;
}

.menu-arrow {
  color: #999;
  font-size: 32rpx;
}

.status-pending {
  color: #faad14;
  background: #fff7e6;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.status-approved {
  color: #07C160;
  background: #f6ffed;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.logout-section {
  margin: 40rpx 30rpx;
}
