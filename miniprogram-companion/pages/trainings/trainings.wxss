.container {
  padding-bottom: 40rpx;
}

.category-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.category-item {
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
}

.category-item.active {
  background: #07C160;
  color: #fff;
}

.training-list {
  padding: 20rpx;
}

.training-card {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  display: flex;
}

.cover {
  width: 200rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.category-tag {
  font-size: 22rpx;
  color: #07C160;
  background: rgba(7, 193, 96, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.views {
  font-size: 22rpx;
  color: #999;
}

.create-time {
  font-size: 22rpx;
  color: #999;
}

.loading, .no-more {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}
